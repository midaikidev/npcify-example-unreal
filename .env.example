# Npcify settings for this demo. Copy this file to .env and fill in your values.
# Create an API key in the Npcify dashboard: Settings > API keys.
# Give the key access to both characters below.

NPCIFY_API_BASE_URL=https://api.npcify.ai
NPCIFY_API_KEY=<your-scoped-api-key>

# Online NPC: every reply comes from the Npcify API.
NPCIFY_ONLINE_CHARACTER_ID=37d81b69-04a8-4720-9cda-4172d4317803

# Offline NPC: plays its baked conversation from Content/NpcifyData/hinata.
# The ID is used only by Scripts/fetch_characters.py.
NPCIFY_OFFLINE_CHARACTER_ID=221608de-65d0-49f0-97b4-800ce08c198d
